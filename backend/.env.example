# Server
PORT=8081
FRONTEND_URL=http://localhost:5173

# PostgreSQL (production)
DB_URL=jdbc:postgresql://localhost:5432/bytestudy
DB_USERNAME=bytestudy
DB_PASSWORD=change-me
DB_DRIVER=org.postgresql.Driver
DDL_AUTO=validate

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=900000
ADMIN_EMAIL=admin@bytepath.local
ADMIN_PASSWORD=replace-me
ADMIN_NAME=System Administrator

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.example.com/api/auth/github/callback

# Exact browser origins, comma-separated; no trailing slash
CORS_ALLOWED_ORIGINS=https://app.example.com

# Supabase Storage (backend only; keep the service-role key secret)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=ByteStudy

# Razorpay (server-side verification/webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OCR worker (Tesseract must be installed on the host/container)
TESSERACT_PATH=/usr/bin/tesseract

# SMTP provider (Resend SMTP, Postmark, SES, etc.)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# Normal email signup always requires verification. SMTP must be configured for signup.
REQUIRE_EMAIL_VERIFICATION=true

# Configure this exact public URL in Razorpay Dashboard > Webhooks:
# https://api.example.com/api/payments/razorpay/webhook
